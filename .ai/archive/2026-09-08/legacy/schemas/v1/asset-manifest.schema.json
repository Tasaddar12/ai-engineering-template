{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/asset-manifest.schema.json",
  "title": "asset-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "asset-manifest"
    },
    "framework_version": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ownership": {
            "type": "string",
            "enum": [
              "framework",
              "seed_only"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "ownership",
          "source_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "migration_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "framework_version",
    "assets",
    "migration_ids"
  ],
  "additionalProperties": false
}
