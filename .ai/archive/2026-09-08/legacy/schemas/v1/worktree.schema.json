{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/worktree.schema.json",
  "title": "worktree",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "worktree"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^TASK-[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "task",
        "integration",
        "control"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "location_hint": {
      "type": "string",
      "minLength": 1
    },
    "requested_base_oid": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "observed_head_oid": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "retained",
        "cleanup_pending",
        "removed"
      ]
    },
    "lease_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "last_observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "task_id",
    "run_id",
    "attempt_id",
    "role",
    "branch",
    "location_hint",
    "requested_base_oid",
    "observed_head_oid",
    "status",
    "lease_id",
    "last_observed_at",
    "evidence_refs"
  ],
  "additionalProperties": false
}
