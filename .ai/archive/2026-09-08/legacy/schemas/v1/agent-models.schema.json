{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/agent-models.schema.json",
  "title": "agent-models",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "agent-models"
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "active_provider": {
      "enum": [
        "openai",
        "anthropic"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "providers": {
      "type": "object",
      "properties": {
        "openai": {
          "$ref": "#/$defs/provider"
        },
        "anthropic": {
          "$ref": "#/$defs/provider"
        }
      },
      "required": [
        "openai",
        "anthropic"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "policy_profile_map": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "review_high": {
          "type": "string",
          "minLength": 1
        },
        "planning": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "implementation",
        "review_high",
        "planning",
        "recovery"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "verified_on",
    "active_provider",
    "sources",
    "providers",
    "roles",
    "policy_profile_map"
  ],
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_rank": {
          "type": "integer",
          "minimum": 1
        },
        "reasoning_effort": {
          "enum": [
            null,
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "effort": {
          "enum": [
            null,
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "model_id",
        "capability_rank",
        "reasoning_effort",
        "effort"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/profile"
          }
        }
      },
      "required": [
        "profiles"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "openai": {
          "type": "string",
          "minLength": 1
        },
        "anthropic": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "openai",
        "anthropic"
      ],
      "additionalProperties": false
    }
  }
}
