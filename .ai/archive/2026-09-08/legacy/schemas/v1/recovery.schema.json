{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/recovery.schema.json",
  "title": "recovery",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "recovery"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{3,}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "failed_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3,}$"
      },
      "minItems": 1
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "old_graph_ref": {
      "type": "string",
      "minLength": 1
    },
    "new_graph_ref": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "repair",
        "split",
        "replace",
        "sequence",
        "augment",
        "merge"
      ]
    },
    "new_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3,}$"
      },
      "minItems": 0
    },
    "superseded_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3,}$"
      },
      "minItems": 0
    },
    "acceptance_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original_id": {
            "type": "string",
            "minLength": 1
          },
          "new_task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TASK-[0-9]{3,}$"
            },
            "minItems": 1
          }
        },
        "required": [
          "original_id",
          "new_task_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "salvage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commit_oid": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "target_task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "reuse_with_fresh_reviews",
              "retain_only"
            ]
          }
        },
        "required": [
          "commit_oid",
          "target_task_id",
          "decision"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "isolation_pending",
        "approved",
        "applied",
        "rejected"
      ]
    },
    "isolation_review_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "lineage_rewrite_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "plan_id",
    "run_id",
    "trigger",
    "failed_task_ids",
    "review_refs",
    "old_graph_ref",
    "new_graph_ref",
    "action",
    "new_task_ids",
    "superseded_task_ids",
    "acceptance_mapping",
    "rationale",
    "salvage",
    "status",
    "isolation_review_ref",
    "lineage_rewrite_count"
  ],
  "additionalProperties": false
}
