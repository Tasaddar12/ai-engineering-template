{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/candidate.schema.json",
  "title": "candidate",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "candidate"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^TASK-[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{3,}$"
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 0
    },
    "base_oid": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "head_oid": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checklist_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_model_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "task_id",
    "plan_id",
    "graph_revision",
    "base_oid",
    "head_oid",
    "diff_sha256",
    "context_refs",
    "validation_refs",
    "checklist_version",
    "policy_model_digest",
    "fingerprint"
  ],
  "additionalProperties": false
}
