{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/workflow-run.schema.json",
  "title": "workflow-run",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "workflow-run"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{3,}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "paused",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "graph_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "pending_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "expected_resource": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "intent",
              "observed",
              "ambiguous"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "type",
          "idempotency_key",
          "expected_resource",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "agent_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_agent_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "used_agent_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "max_rewrites": {
          "type": "integer",
          "minimum": 0
        },
        "used_rewrites": {
          "type": "integer",
          "minimum": 0
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_agent_invocations",
        "used_agent_invocations",
        "max_rewrites",
        "used_rewrites",
        "max_elapsed_seconds"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "pause_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_phase": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "plan_id",
    "status",
    "phase",
    "graph_revision",
    "expected_generation",
    "policy_ref",
    "pending_operations",
    "agent_run_ids",
    "budgets",
    "started_at",
    "finished_at",
    "pause_reason",
    "resume_phase"
  ],
  "additionalProperties": false
}
