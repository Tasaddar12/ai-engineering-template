{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/spec.schema.json",
  "title": "spec",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "spec"
    },
    "id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "superseded",
        "archived"
      ]
    },
    "document_ref": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "adr_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SPEC-[0-9]{3,}$"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "status",
    "document_ref",
    "requirements",
    "adr_refs",
    "superseded_by"
  ],
  "additionalProperties": false
}
