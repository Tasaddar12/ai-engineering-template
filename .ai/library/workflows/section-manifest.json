        "when": "state:phase-mvp-mode",
        "read": ".ai/library/workflows/progress/steps/mvp-display.md"
      },
      {
        "id": "forensic-audit",
        "when": "flag:--forensic",
        "read": ".ai/library/workflows/progress/steps/forensic-audit.md"
      }
