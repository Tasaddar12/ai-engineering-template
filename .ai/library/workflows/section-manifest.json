    "transition": [
      {
        "id": "workstream-collision-check",
        "when": "state:workstream-active",
        "read": ".ai/library/workflows/transition/steps/workstream-collision-check.md"
      }
    ],
    "update": [
      {
        "id": "channel-banner",
        "when": "state:next-channel",
        "read": ".ai/library/workflows/update/steps/channel-banner.md"
      }
    ],
    "verify-work": [
      {
        "id": "automated-ui-verification",
        "when": "state:ui-phase-active",
        "read": ".ai/library/workflows/verify-work/steps/automated-ui-verification.md"
