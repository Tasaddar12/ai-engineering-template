    "quick-batch": [
      {
        "id": "research-phase",
        "when": "flag:--research",
        "read": ".ai/library/workflows/quick-batch/steps/research-phase.md"
      },
      {
        "id": "verification-wave",
        "when": "flag:--validate",
        "read": ".ai/library/workflows/quick-batch/steps/verification-wave.md"
      }
    ],
    "quick": [
      {
        "id": "discussion-phase",
        "when": "flag:--discuss",
        "read": ".ai/library/workflows/quick/steps/discussion-phase.md"
      },
      {
        "id": "research-phase",
        "when": "flag:--research",
        "read": ".ai/library/workflows/quick/steps/research-phase.md"
      },
      {
        "id": "plan-checker-loop",
        "when": "flag:--validate",
        "read": ".ai/library/workflows/quick/steps/plan-checker-loop.md"
      },
      {
        "id": "worktree-pre-dispatch-commit",
        "when": "state:worktrees-enabled",
        "read": ".ai/library/workflows/quick/steps/worktree-pre-dispatch-commit.md"
