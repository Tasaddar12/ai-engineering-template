+        owned = subprocess.Popen(
+            (self.python, "-c", "import time; time.sleep(30)"),
+            env=self.base_environment,
+            shell=False,
+            start_new_session=True,
+        )
+        self.addCleanup(self._kill_process, owned)
+        self.assertEqual(os.getpgid(owned.pid), owned.pid)
