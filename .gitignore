# The immediate-child worktree root is local orchestration state, never a scaffold file.
.worktrees/
# Handoff records for interrupted attempts. Local to one machine, deleted the
# moment they are consumed, and never evidence of what a plan did -- that stays
# in the plan's committed SUMMARY.md.
.planning/handoffs/
# Local reusable check evidence and full subprocess logs.
.planning/verification-receipts/
# Local agent settings and operating-system/editor noise.
.codex/settings.local.*
.DS_Store
Thumbs.db
*.swp

.venv
__pycache__/
*.pyc

# Host installations and their manifests are generated by bin/install.py.
.codex/engineer/
.codex/engineer-install/
.codex/agents/
.codex/commands/
.codex/skills/
.codex/bin/
.codex/scripts/
.codex/hooks/
.claude/engineer/
.claude/engineer-install/
.claude/agents/
.claude/commands/
.claude/skills/
.claude/bin/
.claude/scripts/
.claude/hooks/
