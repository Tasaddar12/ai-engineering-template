{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/archive-manifest.schema.json",
  "title": "archive-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "archive-manifest"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{3,}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "merge_evidence_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "retained_commit_oids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
      },
      "minItems": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "plan_id",
    "reason",
    "merge_evidence_ref",
    "artifacts",
    "retained_commit_oids",
    "created_at"
  ],
  "additionalProperties": false
}
