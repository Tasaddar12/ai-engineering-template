{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/plan.schema.json",
  "title": "plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "plan"
    },
    "id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "isolation",
        "approved",
        "running",
        "integration_review",
        "replanning",
        "delivery_ready",
        "delivering",
        "completed",
        "blocked"
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "spec_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "adr_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "research_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "document_ref": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3,}$"
      },
      "minItems": 1
    },
    "graph_ref": {
      "type": "string",
      "minLength": 1
    },
    "isolation_review_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_state": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "integration_branch": {
      "type": "string",
      "minLength": 1
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    },
    "merge_evidence_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "status",
    "archived",
    "spec_refs",
    "adr_refs",
    "research_refs",
    "document_ref",
    "acceptance_criteria",
    "task_ids",
    "graph_ref",
    "isolation_review_ref",
    "resume_state",
    "integration_branch",
    "target_branch",
    "merge_evidence_ref"
  ],
  "additionalProperties": false
}
