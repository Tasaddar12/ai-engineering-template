{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/task.schema.json",
  "title": "task",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "task"
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "running",
        "validating",
        "review_1",
        "review_2",
        "repairing",
        "accepted",
        "completed",
        "replanning",
        "superseded",
        "blocked"
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3,}$"
      },
      "minItems": 0
    },
    "scope": {
      "type": "object",
      "properties": {
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "prohibited_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "write_paths",
        "read_paths",
        "prohibited_paths",
        "resources"
      ],
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "plan_acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "spec_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "adr_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "research_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "input_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "output_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "estimated_production_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "size_rationale": {
      "type": "string",
      "minLength": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "handoff_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3,}$"
      },
      "minItems": 0
    },
    "resume_state": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "plan_id",
    "title",
    "status",
    "archived",
    "objective",
    "depends_on",
    "scope",
    "acceptance_criteria",
    "plan_acceptance_ids",
    "spec_refs",
    "adr_refs",
    "research_refs",
    "input_contracts",
    "output_contracts",
    "validation_commands",
    "estimated_production_files",
    "size_rationale",
    "out_of_scope",
    "handoff_requirements",
    "attempt_ids",
    "superseded_by",
    "resume_state"
  ],
  "additionalProperties": false
}
