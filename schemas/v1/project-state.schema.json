{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/project-state.schema.json",
  "title": "project-state",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "project-state"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "type": "string",
      "enum": [
        "foundation",
        "implementation",
        "operational"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "control_branch": {
      "type": "string",
      "minLength": 1
    },
    "active_plans": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PLAN-[0-9]{3,}$"
      },
      "minItems": 0
    },
    "completed_plans": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PLAN-[0-9]{3,}$"
      },
      "minItems": 0
    },
    "active_runs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "known_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "framework_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision_index_ref": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "project_id",
    "generation",
    "phase",
    "summary",
    "control_branch",
    "active_plans",
    "completed_plans",
    "active_runs",
    "known_blockers",
    "next_actions",
    "framework_ref",
    "policy_ref",
    "decision_index_ref",
    "updated_at"
  ],
  "additionalProperties": false
}
