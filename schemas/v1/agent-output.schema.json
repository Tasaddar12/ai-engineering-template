{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering.invalid/schemas/v1/agent-output.schema.json",
  "title": "agent-output",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "agent-output"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "failed",
        "succeeded",
        "blocked",
        "cancelled"
      ]
    },
    "actual_model": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_rank": {
          "type": "integer",
          "minimum": 0
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile",
        "provider",
        "model_id",
        "capability_rank",
        "invocation_id"
      ],
      "additionalProperties": false
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "command_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "scope_change_requests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "error_category": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "request_id",
    "attempt_id",
    "status",
    "actual_model",
    "artifact_refs",
    "command_evidence_refs",
    "discoveries",
    "scope_change_requests",
    "error_category",
    "summary"
  ],
  "additionalProperties": false
}
